# Supabase 프로젝트 설정 > API 에서 복사 (Publishable key만 사용. service_role/secret 키는 넣지 마세요)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# 이 API를 호출할 수 있는 프론트 주소 (쉼표로 여러 개)
ALLOWED_ORIGIN=http://localhost:3000

PORT=4000

# 푸시 알림 (선택). 키 만들기: npx web-push generate-vapid-keys  (본인 컴퓨터에서 실행, 비공개 키는 아무에게도 보내지 마세요)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# 서버만 아는 비밀값 (긴 무작위 문자열). DB에는 이 값의 SHA-256 해시만 저장합니다
PUSH_SECRET=

# 네이버 카페 연동 (선택, 앱 → 카페 동시 등록). developers.naver.com 애플리케이션의 값.
# Client Secret은 아무에게도 보내지 마세요. 비어 있으면 '카페에도 올리기'만 꺼집니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 연결 정보 전용 비밀값 (PUSH_SECRET과 다른 값). sha256 해시만 Supabase private.settings의 naver_secret_sha256에 넣는다 (docs/setup.md)
NAVER_SECRET=
# (기본값을 쓰면 비워 두세요) 네이버에 등록한 Callback URL / 연결 후 돌아갈 앱 주소
NAVER_REDIRECT_URI=
APP_URL=
